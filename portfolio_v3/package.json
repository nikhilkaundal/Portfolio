{
  "name": "portfolio_v3",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.152.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.24",
    "lucide-react": "^1.22.0",
    "motion": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "react-scripts": "5.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "typescript": "^5.4.5",
    "web-vitals": "^2.1.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "three": "$three",
    "@pmmmwh/react-refresh-webpack-plugin": {
      "ajv": "^8.20.0",
      "ajv-keywords": "^5.1.0"
    },
    "webpack": {
      "ajv": "^8.20.0",
      "ajv-keywords": "^5.1.0"
    }
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "node --max-old-space-size=4096 ./node_modules/react-scripts/scripts/build.js",
    "test": "react-scripts test --watchAll=false --runInBand",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^@vercel/analytics/react$": "<rootDir>/node_modules/@vercel/analytics/dist/react/index.js",
      "^@vercel/speed-insights/react$": "<rootDir>/node_modules/@vercel/speed-insights/dist/react/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
